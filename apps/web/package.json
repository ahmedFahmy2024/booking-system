{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "doctor": "react-doctor --yes --blocking none --no-telemetry --no-supply-chain",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "typecheck": "tsc -b",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^7.0.8",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "^27.2.4",
    "i18next-browser-languagedetector": "^8.3.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tanstack/devtools": "^0.17.0",
    "@tanstack/devtools-vite": "^0.8.7",
    "@tanstack/react-devtools": "^0.10.15",
    "@tanstack/react-query-devtools": "^5.108.2",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "react-doctor": "0.9.23",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
