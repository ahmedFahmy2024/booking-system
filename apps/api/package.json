{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:cinema": "tsx scripts/seed-cinema.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "auth:verify-flow": "tsx scripts/verify-auth-flow.ts",
    "verify:cinema-paths": "tsx --env-file=.env.test scripts/verify-cinema-paths.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.27",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.1",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
