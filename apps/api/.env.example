# Neon pooled connection string for the application (postgresql://...)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Direct (non-pooled) connection for schema migrations. No -pooler suffix.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

PORT=3000

# Better Auth (same-origin browser and API). Generate a 32+ char secret for production.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:5173

# Server-only key for guest booking links. Required in production.
# Set a stable base64 value with at least 32 random bytes.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GUEST_LINK_KEY=

# One-time first-admin bootstrap: npm run admin:bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Optional live auth check: npm run auth:verify-flow against booking_system_test.
# Use the credentials of an admin already bootstrapped in that test database.
VERIFY_ADMIN_EMAIL=
VERIFY_ADMIN_PASSWORD=
